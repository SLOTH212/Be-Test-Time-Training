{
  "schema": "TTT_INFERENCE_RUNTIME_V1",
  "classification": "SCALEUP_CONFIGURATION",
  "model_family": "Qwen3-4B",
  "model_path": "${MODEL_ROOT}/qwen3_4b_stage2",
  "benchmark_root": "${DATA_ROOT}/ruler_32768",
  "run_root": "${OUTPUT_ROOT}/qwen3_4b",
  "context_length": 32768,
  "ttt_chunk_size": 4096,
  "ttt_layers": [
    0,
    6,
    12,
    18,
    24,
    30
