  "cuda_visible_devices": "INHERIT",
  "workers": 1,
  "fixed_cwe_policy": "INCLUDED",
  "dynamic_excluded_tasks": [
    "ruler_cwe_32k"
  ],
  "generation": {
    "do_sample": false,
    "num_beams": 1,
    "temperature": null,
    "top_p": null,
    "top_k": null,
    "repetition_penalty": 1.0,
    "eos": "MODEL_TOKENIZER_EOS",
    "padding_side": "left",
    "pad_token": "MODEL_TOKENIZER_EOS",
    "max_new_tokens": "BENCHMARK_PER_SAMPLE_EXPLICIT"
  },
  "dynamic": {
    "beam": 4,
    "sweeps": 1,
    "position_order": "forward",
    "downstream_recomputation": true,
    "stored_delta_stitching": false
  },
  "fixed_results_root": "${OUTPUT_ROOT}/qwen3_4b/fixed"
}
