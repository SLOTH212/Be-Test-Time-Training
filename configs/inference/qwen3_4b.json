  "ttt_lr": 1.0,
  "delta_clip_frobenius": 1e-05,
  "fast_weight": "mlp.down_proj.weight",
  "objective": "contextual_hidden_direct_outer_product_no_scalar_loss",
  "update_order": "APPLY_THEN_UPDATE",
  "reset_scope": "PER_SAMPLE",
