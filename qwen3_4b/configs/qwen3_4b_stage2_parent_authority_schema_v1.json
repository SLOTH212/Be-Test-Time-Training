    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tokenizer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_identity": {
      "const": "Qwen3-4B"
    },
    "ttt_layers": {
      "const": [
        0,
        6,
        12,
        18,
        24,
        30
