    "context_length": {
      "const": 32768
    }
  },
  "description": "Launcher additionally validates actual model-only manifest metadata, file hashes, tokenizer and completion; JSON claims alone do not authorize launch. DEBUG authority is accepted only by explicit CPU parser test mode."
}
